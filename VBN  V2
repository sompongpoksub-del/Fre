-- ==========================================
-- 2. ฟังก์ชั่นสร้าง UI หลัก (เมื่อคีย์ถูกต้อง)
-- ==========================================
local function LoadMainUI()
    local MainGui = Instance.new("ScreenGui")
    MainGui.Name = "SpeedScriptV2"
    MainGui.Parent = CoreGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 360, 0, 250)
    MainFrame.Position = UDim2.new(0.5, -180, 0.5, -125)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = MainGui

    local UIStrokeMain = Instance.new("UIStroke")
    UIStrokeMain.Color = Color3.fromRGB(255, 170, 0)
    UIStrokeMain.Thickness = 2
    UIStrokeMain.Parent = MainFrame

    local Header = Instance.new("TextLabel")
    Header.Size = UDim2.new(1, 0, 0, 45)
    Header.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Header.Text = "ความเร็ว 2"
    Header.TextColor3 = Color3.fromRGB(255, 170, 0)
    Header.TextSize = 20
    Header.Font = Enum.Font.SourceSansBold
    Header.Parent = MainFrame

    -- ตัวป้อนเลขความเร็ว
    local SpeedLabel = Instance.new("TextLabel")
    SpeedLabel.Size = UDim2.new(0.9, 0, 0, 25)
    SpeedLabel.Position = UDim2.new(0.05, 0, 0.24, 0)
    SpeedLabel.BackgroundTransparency = 1
    SpeedLabel.Text = "กำหนดความเร็วเป้าหมาย (ใส่ตัวเลข):"
    SpeedLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    SpeedLabel.TextSize = 14
    SpeedLabel.TextXAlignment = Enum.TextXAlignment.Left
    SpeedLabel.Font = Enum.Font.SourceSans
    SpeedLabel.Parent = MainFrame

    local SpeedInput = Instance.new("TextBox")
    SpeedInput.Size = UDim2.new(0.9, 0, 0, 35)
    SpeedInput.Position = UDim2.new(0.05, 0, 0.36, 0)
    SpeedInput.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    SpeedInput.Text = "150"
    SpeedInput.TextColor3 = Color3.fromRGB(0, 255, 127)
    SpeedInput.TextSize = 16
    SpeedInput.Font = Enum.Font.SourceSansBold
    SpeedInput.Parent = MainFrame

    -- แสดงสถานะความเร็วปัจจุบัน
    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Size = UDim2.new(0.9, 0, 0, 25)
    StatusLabel.Position = UDim2.new(0.05, 0, 0.53, 0)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = "ความเร็วปัจจุบัน: 0"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    StatusLabel.TextSize = 14
    StatusLabel.Font = Enum.Font.SourceSans
    StatusLabel.Parent = MainFrame

    -- ปุ่มเปิด/ปิด ระบบความเร็ว
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0.9, 0, 0, 45)
    ToggleBtn.Position = UDim2.new(0.05, 0, 0.72, 0)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    ToggleBtn.Text = "ปิดใช้งานระบบความเร็ว"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.TextSize = 16
    ToggleBtn.Font = Enum.Font.SourceSansBold
    ToggleBtn.Parent = MainFrame

    -- Logic การปรับความเร็วเร่งไต่ระดับ
    local isEnabled = false
    local currentSpeed = 0
    local accelerationRate = 2.5 -- ค่าการค่อยๆ เพิ่มความเร็วในแต่ละรอบ (ปรับความนุ่มนวลได้)

    ToggleBtn.MouseButton1Click:Connect(function()
        isEnabled = not isEnabled
        if isEnabled then
            ToggleBtn.Text = "เปิดใช้งานระบบความเร็ว"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        else
            ToggleBtn.Text = "ปิดใช้งานระบบความเร็ว"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        end
    end)

    -- Loop ควบคุมการไต่ระดับความเร็วของยานพาหนะ
    RunService.Heartbeat:Connect(function()
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("Humanoid") then
            local humanoid = character.Humanoid
            local seat = humanoid.SeatPart

            if seat and seat:IsA("VehicleSeat") then
                local targetSpeed = tonumber(SpeedInput.Text) or 0

                if isEnabled then
                    -- ค่อยๆ ไต่ระดับความเร็วไปหาเป้าหมาย
                    if currentSpeed < targetSpeed then
                        currentSpeed = math.min(currentSpeed + accelerationRate, targetSpeed)
                    elseif currentSpeed > targetSpeed then
                        currentSpeed = math.max(currentSpeed - accelerationRate, targetSpeed)
                    end

                    -- ปรับความเร็วล้อ/รถในแมพ Roblox
                    seat.MaxSpeed = currentSpeed
                    
                    -- ระบบช่วยดันความเร็ว (สำหรับแมพที่จำกัด MaxSpeed ของ Seat)
                    if seat.AssemblyLinearVelocity.Magnitude < currentSpeed then
                        local moveDir = seat.CFrame.LookVector
                        if humanoid.MoveDirection.Magnitude > 0 then
                            seat.AssemblyLinearVelocity = moveDir * currentSpeed
                        end
                    end
                else
                    currentSpeed = math.max(currentSpeed - (accelerationRate * 2), 0)
                end
                StatusLabel.Text = "ความเร็วปัจจุบัน: " .. math.floor(currentSpeed)
            else
                currentSpeed = 0
                StatusLabel.Text = "สถานะ: ไม่ได้นั่งอยู่บนรถ"
            end
        end
    end)
end

